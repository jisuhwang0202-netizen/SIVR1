import numpy as np
from scipy.integrate import odeint
import matplotlib.pyplot as plt

# ==========================================
# 1. 바이러스 및 백신 매개변수 설정
# ==========================================

# 바이러스 종류 (R0: 기초감염재생산수, gamma: 회복률 = 1/격리일수)
VIRUSES = {
    "1": {"name": "COVID-19 (원형)", "R0": 2.5, "gamma": 1/14},
    "2": {"name": "COVID-19 (델타)", "R0": 5.0, "gamma": 1/10},
    "3": {"name": "COVID-19 (오미크론)", "R0": 10.0, "gamma": 1/7},
    "4": {"name": "SARS", "R0": 3.0, "gamma": 1/12}
}

# 백신 종류 (efficacy: 백신의 감염 및 중증 예방 효과)
VACCINES = {
    "1": {"name": "생백신 (Live-attenuated)", "efficacy": 0.70},
    "2": {"name": "재조합 백신 (Recombinant)", "efficacy": 0.80},
    "3": {"name": "mRNA 백신", "efficacy": 0.95}
}

# ==========================================
# 2. SVIR 미분방정식 모델 정의
# ==========================================
def svir_model(y, t, N, beta, gamma, v, efficacy):
    S, V, I, R = y
    
    # 백신 접종자의 감염 확률 감소 반영 (효능 efficacy 적용)
    beta_v = beta * (1.0 - efficacy)
    
    dSdt = -beta * S * I / N - v * S
    dVdt = v * S - beta_v * V * I / N
    dIdt = beta * S * I / N + beta_v * V * I / N - gamma * I
    dRdt = gamma * I
    
    return [dSdt, dVdt, dIdt, dRdt]

# ==========================================
# 3. 시뮬레이션 실행 함수
# ==========================================
def run_simulation(virus_key, vaccine_key, daily_vac_rate=0.005, days=180):
    # 대한민국 인구수 (약 5,160만 명)
    N = 51600000 
    
    # 초깃값 (초기 감염자 100명)
    I0 = 100
    S0 = N - I0
    V0 = 0
    R0_pop = 0
    
    virus = VIRUSES[virus_key]
    vaccine = VACCINES[vaccine_key]
    
    gamma = virus["gamma"]
    R0_val = virus["R0"]
    beta = R0_val * gamma
    efficacy = vaccine["efficacy"]
    
    t = np.linspace(0, days, days)
    
    # 미분방정식 계산
    solution = odeint(
        svir_model, 
        [S0, V0, I0, R0_pop], 
        t, 
        args=(N, beta, gamma, daily_vac_rate, efficacy)
    )
    S, V, I, R = solution.T
    
    # 그래프 출력
    plt.figure(figsize=(10, 6))
    plt.plot(t, S / 1e6, 'b', label='S (Susceptible, 감염 대상군)')
    plt.plot(t, V / 1e6, 'g', label='V (Vaccinated, 백신 접종군)')
    plt.plot(t, I / 1e6, 'r', label='I (Infected, 감염자군)')
    plt.plot(t, R / 1e6, 'gray', label='R (Recovered, 회복자/면역군)')
    
    plt.title(f"SVIR Model Simulation\nVirus: {virus['name']} | Vaccine: {vaccine['name']}", fontsize=14)
    plt.xlabel('Days (일)', fontsize=12)
    plt.ylabel('Population (백만 명)', fontsize=12)
    plt.grid(True, linestyle='--', alpha=0.6)
    plt.legend(fontsize=11)
    plt.tight_layout()
    plt.show()

# ==========================================
# 4. 사용자 입력을 받는 대화형 실행부
# ==========================================
if __name__ == "__main__":
    print("========================================")
    print("   SVIR 대한민국 바이러스-백신 시뮬레이터   ")
    print("========================================\n")
    
    print("[1] 바이러스를 선택하세요:")
    for key, val in VIRUSES.items():
        print(f"  {key}. {val['name']} (기초감염재생산수 R0: {val['R0']})")
    v_choice = input("선택 (1~4 번호 입력): ").strip()
    if v_choice not in VIRUSES:
        v_choice = "3"  # 기본값: 오미크론
        print("잘못 입력하셨습니다. 기본값[3. COVID-19 (오미크론)]으로 진행합니다.")

    print("\n[2] 백신 종류를 선택하세요:")
    for key, val in VACCINES.items():
        print(f"  {key}. {val['name']} (예방 효능: {int(val['efficacy']*100)}%)")
    vac_choice = input("선택 (1~3 번호 입력): ").strip()
    if vac_choice not in VACCINES:
        vac_choice = "3"  # 기본값: mRNA 백신
        print("잘못 입력하셨습니다. 기본값[3. mRNA 백신]으로 진행합니다.")

    print("\n시뮬레이션을 시작합니다...")
    run_simulation(v_choice, vac_choice)
